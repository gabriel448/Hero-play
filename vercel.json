{
  "outputDirectory": "website",
  "buildCommand": "rm -rf website/painel && cp -r painel website/painel",
  "redirects": [
    { "source": "/painel", "destination": "/painel/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/painel/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}