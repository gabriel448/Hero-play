# ─── Secrets ─────────────────────────────────────────────────────────────────
.env

# ─── Supabase ─────────────────────────────────────────────────────────────────

# Segredos locais para dev (ENCRYPTION_KEY, etc.) — NUNCA versionar
supabase/.env

# Arquivos temporarios gerados pelo Supabase CLI (local dev / docker)
supabase/.temp/

# ─── Flutter / Dart ──────────────────────────────────────────────────────────

# Build output
/build/
**/doc/api/

# Instaladores gerados pelo build_installer.ps1 — artefatos, nunca versionar
/installer_output/

# Dart tool cache (gerado pelo pub get / flutter pub get)
.dart_tool/

# Pub cache local (normalmente fica em $HOME, mas por segurança)
.pub-cache/
.pub/

# Gerados automaticamente pelo Flutter ao resolver plugins
.flutter-plugins
.flutter-plugins-dependencies

# Metadados do projeto Flutter (gerado pelo flutter create / flutter upgrade)
.metadata

# Coverage de testes
/coverage/

# Symbolication (gerado em builds obfuscados)
app.*.symbols

# Obfuscation map (gerado com --obfuscate --split-debug-info)
app.*.map.json

# ─── Android ─────────────────────────────────────────────────────────────────

# Cache do Gradle (especifico da maquina)
android/.gradle/
android/.kotlin/

# Build do Android
android/build/

# Artefatos de build (debug / profile / release)
android/app/debug/
android/app/profile/
android/app/release/

# Caminhos locais do SDK Android (especifico da maquina, nunca commitar)
android/local.properties

# ─── Desktop (Windows / macOS / Linux) ───────────────────────────────────────

# Arquivos efemeros gerados pelo Flutter em cada plataforma desktop.
# Cada pasta (windows/ linux/ macos/) ja tem seu proprio .gitignore;
# estas regras sao apenas reforco.
**/ephemeral/

# macOS / Xcode — dados de usuario e dependencias locais
**/xcuserdata/
**/DerivedData/
macos/Pods/
macos/.symlinks/

# ─── IDEs ────────────────────────────────────────────────────────────────────

# IntelliJ / Android Studio
.idea/
*.iml
*.ipr
*.iws

# VS Code (descomente se nao quiser versionar launch.json / tasks.json)
# .vscode/

# ─── Claude Code / Agentes ───────────────────────────────────────────────────

# Configuracoes locais de agentes e skills (especificas da maquina)
.agents/
skills-lock.json

# Settings locais do Claude Code (por maquina — nunca versionar)
.claude/settings.local.json

# Configuracao de servidores MCP (especifica da maquina/ferramenta)
.mcp.json

# ─── Sistema Operacional ─────────────────────────────────────────────────────

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# ─── Assinatura / Chaves ─────────────────────────────────────────────────────

# Reforco para keystores fora do android/ (ex: na raiz do projeto)
*.keystore
*.jks
key.properties

# ─── Logs e temporarios ──────────────────────────────────────────────────────

*.log
*.class
*.pyc
__pycache__/
*.swp
.history
.svn/
.swiftpm/
migrate_working_dir/
relatorio-tvs-samsung-lg.md
Relatorio_Hero_Play_TVs.pdf
relatorio.html
PLANO-TV-E-PAINEIS.md
PRODUCT.md
CLAUDE.md
DESIGN.md
# Pasta de trabalho antiga na raiz. A barra inicial e importante: sem ela a
# regra tambem casava com `com/heroplay/` do projeto Android do app de TV (no
# Windows o Git ignora maiusculas) e engolia o MainActivity.kt.
/HeroPlay/

# ─── App de TV (webOS/Tizen) ─────────────────────────────────────────────────

# Artefatos do build-ipk.sh (stage transpilado + .ipk/.zip publicados) — nunca versionar
/dist-build/
/dist-webos/

# Config local do Claude Code
/.claude/

# Empacotamento do app de TV (gerados por build-ipk.sh / build-wgt.sh / build-apk-tv.sh)
/dist-build-tizen/
/dist-build-android/
/dist-tizen/
/tv-android/app/build/
/tv-android/build/
/tv-android/.gradle/
/tv-android/local.properties
/tv-android/app/src/main/assets/www/
